  <!-- 普通用户条件片段：join project_user 会产生重复行，故统一用 DISTINCT -->
  <sql id="Project_User_Condition" >
	<if test="institution != null">
		and a.ID_INSTITUTION = #{institution,jdbcType=VARCHAR}
	</if>
	<if test="pName != null">
		and a.NAME_PROJECT like '%${pName}%'
	</if>
	<if test="prior != null">
		and a.CD_PRIOR = #{prior,jdbcType=VARCHAR}
	</if>
  </sql>
  <!-- 管理员条件片段 -->
  <sql id="Project_Admin_Condition" >
	<if test="institution != null">
		ID_INSTITUTION = #{institution,jdbcType=VARCHAR} and FLAG_DELETE <![CDATA[<>]]> 'Y'
	</if>
	<if test="pName != null">
		and NAME_PROJECT like '%${pName}%'
	</if>
	<if test="prior != null">
		and CD_PRIOR = #{prior,jdbcType=VARCHAR}
	</if>
  </sql>

  <select id="selectByCondition" resultMap="BaseResultMap" parameterType="map" >
  SELECT DISTINCT a.* FROM projects a, project_user b
WHERE	a.ID_PROJECT = b.ID_PROJECT and a.FLAG_DELETE <![CDATA[<>]]> 'Y'
AND a.ID_PROJECT IN (SELECT	ID_PROJECT 	FROM project_user
	WHERE
	ID_USER = #{idUser,jdbcType=VARCHAR})
	<include refid="Project_User_Condition" />
  </select>
  <!-- 分页版本：供 Grid 懒加载使用，只取当前页 -->
  <select id="selectByConditionPage" resultMap="BaseResultMap" parameterType="map" >
  SELECT DISTINCT a.* FROM projects a, project_user b
WHERE	a.ID_PROJECT = b.ID_PROJECT and a.FLAG_DELETE <![CDATA[<>]]> 'Y'
AND a.ID_PROJECT IN (SELECT	ID_PROJECT 	FROM project_user
	WHERE
	ID_USER = #{idUser,jdbcType=VARCHAR})
	<include refid="Project_User_Condition" />
	LIMIT #{offset,jdbcType=INTEGER}, #{limit,jdbcType=INTEGER}
  </select>
  <select id="countByCondition" resultType="long" parameterType="map" >
  SELECT COUNT(DISTINCT a.ID_PROJECT) FROM projects a, project_user b
WHERE	a.ID_PROJECT = b.ID_PROJECT and a.FLAG_DELETE <![CDATA[<>]]> 'Y'
AND a.ID_PROJECT IN (SELECT	ID_PROJECT 	FROM project_user
